<% layout("/layouts/boilerplate") %>

<style>
    .wishlist-card {
        border-radius: 1rem !important;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.25s ease !important;
        animation: cardRevealUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .wishlist-card:hover {
        transform: translateY(-8px) !important;
        box-shadow: var(--shadow-card-hover) !important;
    }
    .wishlist-card:active {
        transform: translateY(-3px) scale(0.99) !important;
    }
    .wishlist-card .card-img-top {
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .wishlist-card:hover .card-img-top {
        transform: scale(1.07) !important;
    }
    .remove-wishlist-btn {
        transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease !important;
    }
    .remove-wishlist-btn:hover {
        transform: scale(1.15) rotate(90deg) !important;
        background-color: #fee2e2 !important;
    }
</style>

<div class="row mt-4 mb-5">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h3 class="fw-bold mb-1"><i class="fa-solid fa-heart text-danger me-2"></i>My Wishlist</h3>
                <p class="text-muted mb-0"><%= wishlist.length %> saved <%= wishlist.length === 1 ? 'property' : 'properties' %></p>
            </div>
            <a href="/listings" class="btn btn-outline-dark" style="border-radius: 999px;">
                <i class="fa-solid fa-compass me-1"></i> Explore More Stays
            </a>
        </div>

        <% if (wishlist.length === 0) { %>
            <div class="text-center py-5">
                <i class="fa-regular fa-heart text-muted mb-3" style="font-size: 3.5rem;"></i>
                <h4>Your wishlist is empty</h4>
                <p class="text-muted">As you search, tap the heart icon on any stay to save your favorite spots here.</p>
                <a href="/listings" class="btn btn-brand mt-2" style="border-radius: 999px; padding: 0.5rem 1.5rem;">
                    Find Places to Stay
                </a>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                <% for (let listing of wishlist) { %>
                    <div class="col" id="wishlist-item-<%= listing._id %>">
                        <div class="card h-100 border-0 shadow-sm wishlist-card">
                            <div class="position-relative">
                                <a href="/listings/<%= listing._id %>">
                                    <img 
                                        src="<%= listing.image ? listing.image.url : '' %>" 
                                        class="card-img-top" 
                                        alt="<%= listing.title %>"
                                        style="height: 200px; object-fit: cover;"
                                    />
                                </a>
                                <button 
                                    class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 rounded-circle shadow-sm remove-wishlist-btn"
                                    data-id="<%= listing._id %>"
                                    title="Remove from wishlist"
                                    style="width: 34px; height: 34px; padding: 0; display: flex; align-items: center; justify-content: center;"
                                >
                                    <i class="fa-solid fa-xmark text-danger"></i>
                                </button>
                            </div>
                            <div class="card-body p-3">
                                <h6 class="card-title fw-bold text-truncate mb-1">
                                    <a href="/listings/<%= listing._id %>" class="text-decoration-none">
                                        <%= listing.title %>
                                    </a>
                                </h6>
                                <p class="text-muted small mb-2"><%= listing.location %>, <%= listing.country %></p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>
                                        <b class="fs-6">&#8377;<%= listing.price.toLocaleString("en-IN") %></b>
                                        <span class="text-muted small"> / night</span>
                                    </div>
                                    <a href="/listings/<%= listing._id %>#booking" class="btn btn-sm btn-brand" style="border-radius: 999px; font-weight: 600; padding: 0.35rem 0.9rem;">
                                        Book
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
    document.querySelectorAll(".remove-wishlist-btn").forEach(btn => {
        btn.addEventListener("click", async function (e) {
            e.preventDefault();
            const listingId = this.dataset.id;
            try {
                const res = await fetch(`/wishlist/${listingId}/toggle`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });
                const data = await res.json();
                if (data.success && !data.favorited) {
                    const cardCol = document.getElementById(`wishlist-item-${listingId}`);
                    if (cardCol) {
                        cardCol.style.transition = "transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s ease";
                        cardCol.style.transform = "scale(0.85) translateY(16px)";
                        cardCol.style.opacity = "0";
                        setTimeout(() => {
                            cardCol.remove();
                            if (document.querySelectorAll("[id^='wishlist-item-']").length === 0) {
                                location.reload();
                            }
                        }, 280);
                    }
                    if (typeof updateNavWishlistBadge === "function" && typeof data.count !== "undefined") {
                        updateNavWishlistBadge(data.count);
                    }
                    if (typeof showToast === "function") {
                        showToast(data.message || "Removed from wishlist");
                    }
                }
            } catch (err) {
                console.error("Error removing wishlist item:", err);
            }
        });
    });
</script>
