<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper">
    <div class="auth-card shadow-lg">
        <div class="text-center mb-4">
            <a href="/listings" class="text-decoration-none">
                <img src="/images/logo.svg" alt="StayHub" height="42" class="mb-2" />
            </a>
            <h1 class="fw-bold">Welcome back</h1>
            <p class="auth-subtitle">Log in to manage your trips, wishlist, and bookings</p>
        </div>

        <!-- Google OAuth Button -->
        <a href="/auth/google" class="btn-google-oauth mb-3">
            <svg viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.04 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Continue with Google</span>
        </a>

        <!-- Quick Demo Login Banner for Reviewers & Quick Testing -->
        <div class="p-3 mb-3 rounded-4 border bg-body-tertiary shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold d-flex align-items-center gap-1">
                    <i class="fa-solid fa-bolt text-warning"></i> Quick Demo Access
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">1-Click Login</span>
            </div>
            <p class="text-muted small mb-2" style="font-size: 0.78rem; line-height: 1.35;">
                Testing bookings or reviews? Click below to instantly log in as a verified guest without typing.
            </p>
            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill py-2 fw-semibold w-100 d-flex align-items-center justify-content-center gap-2" id="demoGuestQuickBtn" onclick="fillAndSubmitDemo('priya.travels@stayhub.test', 'Guest@123')">
                <i class="fa-solid fa-user-check text-success"></i>
                <span>Instant Demo Guest (Priya Sharma)</span>
            </button>
        </div>

        <!-- Divider -->
        <div class="auth-divider">
            <span>or log in with email</span>
        </div>

        <form action="/login" method="POST" class="needs-validation" id="loginForm" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold small">Email Address</label>
                <div class="input-icon-wrap">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input
                        name="email"
                        id="email"
                        type="email"
                        placeholder="you@example.com"
                        class="form-control"
                        required
                        autofocus
                    />
                </div>
                <div class="invalid-feedback small">Please enter your email address.</div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label for="password" class="form-label fw-semibold small mb-0">Password</label>
                    <a href="/forgot-password" style="color: var(--brand); font-size: 0.8rem; text-decoration: none;" class="fw-medium">Forgot password?</a>
                </div>
                <div class="input-icon-wrap has-pwd-toggle">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input
                        name="password"
                        id="password"
                        type="password"
                        placeholder="Enter your password"
                        class="form-control"
                        required
                    />
                    <button
                        type="button"
                        class="btn-pwd-toggle"
                        id="togglePassword"
                        tabindex="-1"
                        aria-label="Toggle password visibility"
                    >
                        <i class="fa-regular fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <div id="capsLockAlert" class="text-warning small mt-1 d-none">
                    <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Caps Lock is ON
                </div>
                <div class="invalid-feedback small">Please enter your password.</div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label text-muted small" for="rememberMe">
                        Remember this device
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-brand py-2 fw-semibold" id="loginBtn">
                <span>Log In</span>
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <span class="text-muted small">New to StayHub?</span>
            <a href="/signup" class="fw-bold ms-1" style="color: var(--brand); text-decoration: none;">Sign up for free</a>
        </div>
    </div>
</div>

<script>
    // Password toggle
    const pwdInput = document.getElementById("password");
    const toggleBtn = document.getElementById("togglePassword");
    const toggleIcon = document.getElementById("toggleIcon");

    if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener("click", () => {
            const isHidden = pwdInput.type === "password";
            pwdInput.type = isHidden ? "text" : "password";
            toggleIcon.className = isHidden ? "fa-regular fa-eye-slash" : "fa-regular fa-eye";
        });
    }

    // Caps Lock Detector
    const capsAlert = document.getElementById("capsLockAlert");
    if (pwdInput && capsAlert) {
        pwdInput.addEventListener("keyup", function(event) {
            if (event.getModifierState && event.getModifierState("CapsLock")) {
                capsAlert.classList.remove("d-none");
            } else {
                capsAlert.classList.add("d-none");
            }
        });
    }

    // Loading state on submit
    const loginForm = document.getElementById("loginForm");
    const loginBtn = document.getElementById("loginBtn");
    if (loginForm && loginBtn) {
        loginForm.addEventListener("submit", function() {
            if (this.checkValidity()) {
                loginBtn.disabled = true;
                loginBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Signing in...';
            }
        });
    }

    // 1-Click Demo Guest Handler
    function fillAndSubmitDemo(email, pwd) {
        const emailInput = document.getElementById("email");
        const pwdInput = document.getElementById("password");
        const form = document.getElementById("loginForm");
        const btn = document.getElementById("demoGuestQuickBtn");

        if (emailInput && pwdInput && form) {
            emailInput.value = email;
            pwdInput.value = pwd;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Logging in as Demo Guest...';
            }
            form.submit();
        }
    }
</script>