<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper">
    <div class="auth-card shadow-lg text-center">
        <div class="mb-3">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger mb-3" style="width: 64px; height: 64px;">
                <i class="fa-solid fa-key fs-3"></i>
            </div>
            <h1 class="fw-bold">Forgot Password?</h1>
            <p class="auth-subtitle">No worries! Enter your email address and we will help you reset it.</p>
        </div>

        <form action="/forgot-password" method="POST" class="needs-validation text-start" id="forgotForm" novalidate>
            <div class="mb-4">
                <label for="email" class="form-label fw-semibold small">Registered Email</label>
                <div class="input-icon-wrap">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input
                        name="email"
                        id="email"
                        type="email"
                        placeholder="you@example.com"
                        class="form-control"
                        required
                        autofocus
                    />
                </div>
                <div class="invalid-feedback small">Please enter your registered email address.</div>
            </div>

            <button type="submit" class="btn btn-brand py-2 fw-semibold" id="submitBtn">
                <span>Continue</span>
            </button>
        </form>

        <div class="mt-4 pt-3 border-top">
            <a href="/login" class="text-muted small fw-semibold text-decoration-none">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Log in
            </a>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById("forgotForm");
    const btn = document.getElementById("submitBtn");
    if (form && btn) {
        form.addEventListener("submit", function() {
            if (this.checkValidity()) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Checking...';
            }
        });
    }
</script>