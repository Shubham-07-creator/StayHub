<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper">
    <div class="auth-card">
        <h1>Forgot Password</h1>
        <p class="text-muted">Enter your email and we'll send you a code to reset your password.</p>
        <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input
                name="email"
                id="email"
                type="email"
                class="form-control"
                required
                />
            </div>
            <button type="submit" class="btn btn-brand w-100">Send Code</button>
        </form>
        <p class="text-center mt-3 mb-0">
            <a href="/login" style="color: var(--brand); font-weight: 600;">Back to Login</a>
        </p>
    </div>
</div>