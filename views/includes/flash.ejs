<% if(success && success.length) { %>
<div class="stayhub-flash-wrap my-3">
    <div class="stayhub-flash stayhub-flash-success alert alert-dismissible fade show" role="alert" data-auto-dismiss="4500">
        <div class="stayhub-flash-icon">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="stayhub-flash-content">
            <div class="stayhub-flash-title">Success</div>
            <div class="stayhub-flash-message"><%= success %></div>
        </div>
        <button type="button" class="stayhub-flash-close" data-bs-dismiss="alert" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="stayhub-flash-progress stayhub-flash-progress-success"></div>
    </div>
</div>
<% } %>

<% if(error && error.length) { %>
<div class="stayhub-flash-wrap my-3">
    <div class="stayhub-flash stayhub-flash-danger alert alert-dismissible fade show" role="alert" data-auto-dismiss="5500">
        <div class="stayhub-flash-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="stayhub-flash-content">
            <div class="stayhub-flash-title">Attention</div>
            <div class="stayhub-flash-message"><%= error %></div>
        </div>
        <button type="button" class="stayhub-flash-close" data-bs-dismiss="alert" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="stayhub-flash-progress stayhub-flash-progress-danger"></div>
    </div>
</div>
<% } %>