<!-- SMART SEARCH AUTOCOMPLETE SCRIPT -->
<script>
  (function () {
    const searchInput = document.getElementById("navGlobalSearchInput");
    const popover = document.getElementById("searchSuggestPopover");
    const trendingSec = document.getElementById("trendingDestSection");
    const liveSec = document.getElementById("liveSuggestSection");
    const resultsList = document.getElementById("suggestResultsList");
    const countText = document.getElementById("suggestCountText");

    if (!searchInput || !popover) return;

    let debounceTimer = null;

    // Show popover on focus
    searchInput.addEventListener("focus", function () {
      popover.classList.add("active");
      if (!this.value.trim()) {
        trendingSec.classList.remove("d-none");
        liveSec.classList.add("d-none");
      }
    });

    // Close when clicking outside
    document.addEventListener("click", function (e) {
      if (!e.target.closest(".nav-search-wrap-relative")) {
        popover.classList.remove("active");
      }
    });

    // Close on Escape
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        popover.classList.remove("active");
        searchInput.blur();
      }
    });

    // Live search on input
    searchInput.addEventListener("input", function () {
      const q = this.value.trim();
      clearTimeout(debounceTimer);

      if (!q) {
        trendingSec.classList.remove("d-none");
        liveSec.classList.add("d-none");
        return;
      }

      trendingSec.classList.add("d-none");
      liveSec.classList.remove("d-none");
      resultsList.innerHTML = '<div class="text-center py-3 text-muted small"><i class="fa-solid fa-spinner fa-spin me-2 text-danger"></i>Searching stays...</div>';

      debounceTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/listings/suggestions?q=${encodeURIComponent(q)}`);
          const data = await res.json();
          const items = data.suggestions || [];

          if (items.length === 0) {
            resultsList.innerHTML = `
              <div class="text-center py-3 text-muted small">
                <i class="fa-solid fa-house-circle-xmark fs-4 text-secondary mb-2 d-block"></i>
                No stays found matching "${q}"
              </div>
            `;
            if (countText) countText.textContent = "0 results";
            return;
          }

          if (countText) countText.textContent = `${items.length} stay${items.length > 1 ? 's' : ''}`;

          resultsList.innerHTML = items.map(item => `
            <a href="/listings/${item._id}" class="suggest-item">
              <img src="${item.image && item.image.url ? item.image.url : '/images/placeholder.jpg'}" alt="${item.title}" class="suggest-thumb" />
              <div class="suggest-info">
                <h6>${item.title}</h6>
                <p><i class="fa-solid fa-location-dot text-danger me-1"></i>${item.location}, ${item.country}</p>
              </div>
              <div class="suggest-price">
                ₹${Number(item.price).toLocaleString("en-IN")}<small class="text-muted fw-normal">/nt</small>
              </div>
            </a>
          `).join("");
        } catch (err) {
          resultsList.innerHTML = '<div class="text-center py-2 text-danger small">Error loading suggestions.</div>';
        }
      }, 140);
    });
  })();
</script>
