<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-12 col-md-10 offset-md-1">
        <h3 class="mb-4">Reservations for "<%= listing.title %>"</h3>

        <% if (bookings.length === 0) { %>
            <p>No reservations yet for this listing.</p>
        <% } %>

        <% bookings.forEach(function(booking) { %>
            <% if (booking.user) { %>
            <div class="card reservation-row mb-3 p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <h5 class="mb-1">@<%= booking.user.username %></h5>
                        <p class="mb-1">
                            <b>Check-in:</b> <%= booking.checkIn.toDateString() %>
                            &nbsp;|&nbsp;
                            <b>Check-out:</b> <%= booking.checkOut.toDateString() %>
                        </p>
                        <p class="mb-1"><b>Guests:</b> <%= booking.guests %></p>
                        <p class="mb-0">
                            <b>Total:</b> &#8377;<%= booking.totalPrice.toLocaleString("en-IN") %>
                        </p>
                    </div>
                    <span class="status-badge <%= booking.status === 'cancelled' ? 'status-cancelled' : 'status-confirmed' %>">
                        <%= booking.status %>
                    </span>
                </div>
            </div>
            <% } %>
        <% }); %>

        <a href="/listings/<%= listing._id %>" class="btn btn-dark-outline mt-2">Back to Listing</a>
    </div>
</div>
