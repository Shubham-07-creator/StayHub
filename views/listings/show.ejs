<% layout("/layouts/boilerplate") %>

<style>
    :root {
        --sp-brand: #fe424d;
        --sp-brand-dark: #e02f3a;
        --sp-brand-soft: rgba(254, 66, 77, 0.08);
        --sp-bg-card: #ffffff;
        --sp-bg-subtle: #f8fafc;
        --sp-text: #0f172a;
        --sp-muted: #64748b;
        --sp-border: #e2e8f0;
        --sp-border-hover: #cbd5e1;
        --sp-radius-xl: 1.25rem;
        --sp-radius: 0.85rem;
        --sp-radius-sm: 0.5rem;
        --sp-shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06);
        --sp-shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
        --sp-shadow-lg: 0 16px 36px rgba(15, 23, 42, 0.12);
    }

    [data-bs-theme="dark"],
    [data-theme="dark"] {
        --sp-bg-card: #161922;
        --sp-bg-subtle: #1e2230;
        --sp-text: #f3f4f6;
        --sp-muted: #9ca3af;
        --sp-border: #252936;
        --sp-border-hover: #374151;
        --sp-brand-soft: rgba(254, 66, 77, 0.15);
        --sp-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
        --sp-shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
        --sp-shadow-lg: 0 16px 36px rgba(0, 0, 0, 0.5);
    }

    /* BREADCRUMB */
    .sp-breadcrumb {
        font-size: 0.85rem;
        color: var(--sp-muted);
        margin-bottom: 0.75rem;
    }
    .sp-breadcrumb a {
        color: var(--sp-muted);
        text-decoration: none;
        transition: color 0.15s ease;
    }
    .sp-breadcrumb a:hover {
        color: var(--sp-brand);
    }

    /* TITLE & HEADER */
    .sp-header {
        margin-bottom: 1.25rem;
    }
    .sp-title {
        font-size: clamp(1.75rem, 3.5vw, 2.4rem);
        font-weight: 800;
        color: var(--sp-text);
        letter-spacing: -0.025em;
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }
    .sp-meta-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .sp-meta-left {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.95rem;
        color: var(--sp-muted);
    }
    .sp-meta-left i.fa-star {
        color: #f59e0b;
    }
    .sp-meta-left .sp-location-link {
        color: var(--sp-text);
        font-weight: 600;
        text-decoration: underline;
        cursor: pointer;
    }

    /* ACTION BUTTONS */
    .sp-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: transparent;
        border: 1px solid var(--sp-border);
        color: var(--sp-text);
        padding: 0.45rem 1rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sp-action-btn:hover {
        background: var(--sp-bg-subtle);
        border-color: var(--sp-border-hover);
        color: var(--sp-text);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    }
    .sp-action-btn:active {
        transform: scale(0.95);
    }
    .sp-action-btn.active {
        background: #fee2e2;
        border-color: #fca5a5;
        color: #dc2626;
    }
    [data-bs-theme="dark"] .sp-action-btn.active,
    [data-theme="dark"] .sp-action-btn.active {
        background: rgba(220, 38, 38, 0.2);
        border-color: #dc2626;
        color: #f87171;
    }

    /* HERO IMAGE */
    .sp-hero-container {
        position: relative;
        border-radius: var(--sp-radius-xl);
        overflow: hidden;
        box-shadow: var(--sp-shadow-md);
        margin-bottom: 2rem;
        background: #000;
    }
    .sp-hero-img {
        width: 100%;
        height: 52vh;
        min-height: 320px;
        max-height: 540px;
        object-fit: cover;
        display: block;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sp-hero-container:hover .sp-hero-img {
        transform: scale(1.03);
    }
    .sp-hero-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(8px);
        color: #fff;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        z-index: 2;
    }
    .sp-hero-category {
        position: absolute;
        bottom: 1rem;
        right: 1rem;
        background: rgba(255, 255, 255, 0.92);
        color: #222;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    [data-bs-theme="dark"] .sp-hero-category,
    [data-theme="dark"] .sp-hero-category {
        background: rgba(22, 25, 34, 0.92);
        color: #f3f4f6;
    }

    /* HOST & SPECS SECTION */
    .sp-host-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--sp-border);
        margin-bottom: 1.5rem;
    }
    .sp-host-info h4 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--sp-text);
        margin-bottom: 0.25rem;
    }
    .sp-specs-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        color: var(--sp-muted);
        font-size: 0.9rem;
    }
    .sp-host-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fe424d, #f97316);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.4rem;
        box-shadow: 0 4px 12px rgba(254, 66, 77, 0.3);
    }

    /* HIGHLIGHTS SECTION */
    .sp-highlight-item {
        display: flex;
        gap: 1.1rem;
        align-items: flex-start;
        margin-bottom: 1.25rem;
    }
    .sp-highlight-icon {
        font-size: 1.35rem;
        color: var(--sp-text);
        margin-top: 0.15rem;
        width: 24px;
        text-align: center;
    }
    .sp-highlight-content h6 {
        font-weight: 700;
        color: var(--sp-text);
        margin-bottom: 0.15rem;
        font-size: 0.95rem;
    }
    .sp-highlight-content p {
        color: var(--sp-muted);
        margin-bottom: 0;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    /* SECTION DIVIDER */
    .sp-divider {
        height: 1px;
        background: var(--sp-border);
        margin: 2rem 0;
    }

    /* SECTION TITLE */
    .sp-sec-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--sp-text);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    /* DESCRIPTION */
    .sp-description-text {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--sp-text);
        white-space: pre-line;
    }

    /* AMENITIES GRID */
    .sp-amenities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }
    .sp-amenity-card {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        background: var(--sp-bg-subtle);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        color: var(--sp-text);
        font-size: 0.92rem;
        font-weight: 500;
        transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.2s ease,
                    box-shadow 0.24s ease,
                    background-color 0.2s ease;
    }
    .sp-amenity-card:hover {
        transform: translateY(-4px) scale(1.02);
        border-color: var(--sp-brand);
        box-shadow: 0 6px 18px rgba(254, 66, 77, 0.12);
        background: var(--sp-bg-card);
    }
    .sp-amenity-card:hover i {
        animation: iconWiggle 0.45s ease;
    }
    .sp-amenity-card i {
        font-size: 1.15rem;
        color: var(--sp-brand);
        width: 20px;
        text-align: center;
        transition: transform 0.2s ease;
    }

    /* BOOKING WIDGET (STICKY RIGHT) & HOST PORTAL */
    .sp-widget {
        background: var(--sp-bg-card);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius-xl);
        box-shadow: var(--sp-shadow-lg);
        padding: 1.75rem;
        position: sticky;
        top: 6.5rem;
        z-index: 10;
        animation: cardRevealUp 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;
        transition: box-shadow 0.3s ease, border-color 0.25s ease;
    }
    .sp-widget:hover {
        box-shadow: 0 20px 42px -8px rgba(15, 23, 42, 0.16);
    }
    .sp-widget-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--sp-border);
        margin-bottom: 1.25rem;
    }
    .sp-widget-price {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--sp-text);
    }
    .sp-widget-price-sub {
        font-size: 0.88rem;
        color: var(--sp-muted);
        font-weight: normal;
    }
    .sp-widget-gst-pill {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        color: #10b981;
        background: rgba(16, 185, 129, 0.1);
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        margin-top: 0.2rem;
    }

    /* DATE PICKER CONTAINER */
    .sp-dates-box {
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        overflow: hidden;
        margin-bottom: 0.75rem;
        background: var(--sp-bg-card);
    }
    .sp-date-col {
        padding: 0.65rem 0.85rem;
    }
    .sp-date-col:first-child {
        border-right: 1px solid var(--sp-border);
    }
    .sp-date-label {
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--sp-muted);
        margin-bottom: 0.2rem;
        display: block;
    }
    .sp-date-input {
        border: none;
        background: transparent;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--sp-text);
        width: 100%;
        padding: 0;
        outline: none;
    }

    /* GUEST SELECTOR */
    .sp-guests-box {
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        padding: 0.65rem 0.85rem;
        background: var(--sp-bg-card);
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .sp-stepper-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid var(--sp-border);
        background: var(--sp-bg-subtle);
        color: var(--sp-text);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
        cursor: pointer;
        user-select: none;
        transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
                    border-color 0.15s ease,
                    color 0.15s ease,
                    background 0.15s ease;
    }
    .sp-stepper-btn:hover:not(:disabled) {
        border-color: var(--sp-brand);
        color: var(--sp-brand);
        background: var(--sp-bg-card);
        transform: scale(1.12);
    }
    .sp-stepper-btn:active:not(:disabled) {
        transform: scale(0.92);
    }
    .sp-stepper-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    /* PRICE BREAKDOWN CARD */
    .sp-breakdown-card {
        background: var(--sp-bg-subtle);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        padding: 1rem;
        font-size: 0.88rem;
        margin-bottom: 1rem;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .sp-price-pulse {
        animation: pageReveal 0.25s ease;
    }
    .sp-price-line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.45rem;
        color: var(--sp-muted);
    }
    .sp-price-line strong {
        color: var(--sp-text);
    }
    .sp-gst-box {
        background: var(--sp-bg-card);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius-sm);
        padding: 0.65rem 0.85rem;
        margin: 0.5rem 0;
    }
    .sp-gst-header {
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--sp-text);
        margin-bottom: 0.3rem;
    }
    .sp-gst-subline {
        display: flex;
        justify-content: space-between;
        font-size: 0.74rem;
        color: var(--sp-muted);
        margin-bottom: 0.15rem;
    }
    .sp-total-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--sp-text);
        padding-top: 0.75rem;
        border-top: 1px solid var(--sp-border);
    }

    /* REVIEWS SECTION */
    .sp-review-card {
        background: var(--sp-bg-card);
        border: 1px solid var(--sp-border);
        border-radius: var(--sp-radius);
        padding: 1.25rem;
        box-shadow: var(--sp-shadow-sm);
        height: 100%;
        animation: cardRevealUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    border-color 0.25s ease;
    }
    .sp-review-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 30px -4px rgba(15, 23, 42, 0.12), 0 4px 8px -2px rgba(15, 23, 42, 0.05);
        border-color: var(--sp-brand);
    }
    .sp-review-card:hover .sp-reviewer-avatar {
        transform: scale(1.1) rotate(5deg);
    }
    .sp-review-card:hover .fa-star {
        animation: starSparkle 0.45s ease;
    }
    .sp-reviewer-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #3b82f6;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* MAP CONTAINER */
    .sp-map-box {
        height: 400px;
        width: 100%;
        border-radius: var(--sp-radius-xl);
        overflow: hidden;
        border: 1px solid var(--sp-border);
        box-shadow: var(--sp-shadow-md);
    }

    /* ADMIN CONTROLS BANNER */
    .sp-admin-banner {
        background: linear-gradient(135deg, rgba(254, 66, 77, 0.08) 0%, rgba(254, 66, 77, 0.03) 100%);
        border: 1.5px solid rgba(254, 66, 77, 0.25);
        border-radius: var(--sp-radius);
        padding: 1rem 1.25rem;
        margin-bottom: 2rem;
    }

    @media (max-width: 991.98px) {
        .sp-widget {
            position: static;
            margin-top: 2rem;
        }
        .sp-hero-img {
            height: 38vh;
        }
    }
</style>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN || '' %>";
    const listing = <%- JSON.stringify(listing) %>;
    const bookedRanges = <%- JSON.stringify(bookings || []) %>;
    const razorpayUserName = <%- currUser ? JSON.stringify(currUser.username) : "''" %>;
    const razorpayUserEmail = <%- currUser ? JSON.stringify(currUser.email) : "''" %>;
</script>

<div class="container py-3">

    <!-- 1. BREADCRUMBS -->
    <nav class="sp-breadcrumb d-flex align-items-center gap-2">
        <a href="/listings"><i class="fa-solid fa-house"></i> Home</a>
        <span>&rsaquo;</span>
        <a href="/listings?category=<%= listing.category %>"><%= listing.category ? (listing.category.charAt(0).toUpperCase() + listing.category.slice(1)) : 'Stays' %></a>
        <span>&rsaquo;</span>
        <span class="text-truncate" style="max-width: 320px;"><%= listing.title %></span>
    </nav>

    <!-- 2. TITLE & ACTION BAR -->
    <div class="sp-header">
        <h1 class="sp-title"><%= listing.title %></h1>
        <div class="sp-meta-bar">
            <div class="sp-meta-left">
                <% 
                    const avgRating = listing.reviews.length > 0 
                        ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) 
                        : null;
                %>
                <% if (avgRating) { %>
                    <span class="fw-bold text-dark d-flex align-items-center gap-1">
                        <i class="fa-solid fa-star"></i> <%= avgRating %>
                    </span>
                    <span>&bull;</span>
                    <a href="#reviewsSection" class="text-decoration-none text-muted fw-semibold">
                        <%= listing.reviews.length %> review<%= listing.reviews.length > 1 ? 's' : '' %>
                    </a>
                    <span>&bull;</span>
                <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary fw-semibold">
                        <i class="fa-solid fa-sparkles text-warning me-1"></i> New to StayHub
                    </span>
                    <span>&bull;</span>
                <% } %>

                <span class="sp-location-link" onclick="document.getElementById('mapSection').scrollIntoView({ behavior: 'smooth' })">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                </span>

                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="fa-solid fa-award me-1"></i> Superhost Stay
                </span>
            </div>

            <!-- SHARE & WISHLIST BUTTONS -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="sp-action-btn" onclick="handleShareListing()">
                    <i class="fa-solid fa-arrow-up-from-bracket"></i> Share
                </button>

                <% const isWishlisted = typeof userWishlist !== "undefined" && userWishlist.includes(listing._id.toString()); %>
                <button 
                    type="button" 
                    id="showWishlistBtn" 
                    class="sp-action-btn <%= isWishlisted ? 'active' : '' %>"
                    onclick="handleShowWishlistToggle('<%= listing._id %>')"
                >
                    <i class="<%= isWishlisted ? 'fa-solid' : 'fa-regular' %> fa-heart" id="showWishlistIcon"></i>
                    <span id="showWishlistText"><%= isWishlisted ? 'Saved' : 'Save' %></span>
                </button>
            </div>
        </div>
    </div>

    <!-- 3. HERO IMAGE SHOWCASE -->
    <div class="sp-hero-container">
        <span class="sp-hero-badge">
            <i class="fa-solid fa-shield-check text-success me-1"></i> StayHub Verified Property
        </span>
        <img
            src="<%= listing.image.url %>"
            class="sp-hero-img"
            alt="<%= listing.title %>"
        />
        <span class="sp-hero-category">
            <i class="fa-solid fa-compass me-1 text-danger"></i> <%= listing.category ? listing.category.toUpperCase() : 'HOMESTAY' %>
        </span>
    </div>

    <!-- 4. MAIN CONTENT ROW (LEFT: DETAILS, RIGHT: STICKY BOOKING WIDGET) -->
    <div class="row g-4">

        <!-- LEFT COLUMN: PROPERTY DETAILS -->
        <div class="col-12 col-lg-8">

            <!-- HOST & SPECS BANNER -->
            <div class="sp-host-card">
                <div class="sp-host-info">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h4 class="mb-0">Hosted by <%= listing.owner ? listing.owner.username : 'Shubham Kumar' %></h4>
                        <% if (listing.owner && listing.owner.email === (process.env.ADMIN_EMAIL || 'shubhamkumar979883@gmail.com')) { %>
                            <span class="badge bg-danger text-white rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-crown text-warning me-1"></i> Admin & Superhost
                            </span>
                        <% } else { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-award me-1"></i> Superhost
                            </span>
                        <% } %>
                    </div>
                    <div class="sp-specs-pills">
                        <span><i class="fa-solid fa-user-group me-1"></i> Up to <%= listing.maxGuests || 4 %> guests</span>
                        <span>&bull;</span>
                        <span><i class="fa-solid fa-bed me-1"></i> Entire Villa / Room</span>
                        <span>&bull;</span>
                        <span><i class="fa-solid fa-circle-check text-success me-1"></i> Free Cancellation</span>
                    </div>
                </div>
                <div class="sp-host-avatar" title="Host: <%= listing.owner ? listing.owner.username : 'Shubham Kumar' %>">
                    <% if (listing.owner && listing.owner.avatar) { %>
                        <img src="<%= listing.owner.avatar %>" alt="<%= listing.owner.username %>" class="w-100 h-100 rounded-circle object-fit-cover" />
                    <% } else { %>
                        <%= (listing.owner && listing.owner.username) ? listing.owner.username.charAt(0).toUpperCase() : 'S' %>
                    <% } %>
                </div>
            </div>

            <!-- AIRBNB-STYLE KEY HIGHLIGHTS -->
            <div class="mb-4">
                <div class="sp-highlight-item">
                    <div class="sp-highlight-icon"><i class="fa-solid fa-key text-danger"></i></div>
                    <div class="sp-highlight-content">
                        <h6>Self check-in &bull; Keyless entry</h6>
                        <p>Check yourself in with the secure door keypad or dedicated host reception.</p>
                    </div>
                </div>
                <div class="sp-highlight-item">
                    <div class="sp-highlight-icon"><i class="fa-solid fa-medal text-warning"></i></div>
                    <div class="sp-highlight-content">
                        <h6>Experienced Superhost &bull; Admin Verified</h6>
                        <p><%= listing.owner ? listing.owner.username : 'Shubham Kumar' %> is an officially verified StayHub Superhost with 100% response rate.</p>
                    </div>
                </div>
                <div class="sp-highlight-item">
                    <div class="sp-highlight-icon"><i class="fa-solid fa-shield-halved text-success"></i></div>
                    <div class="sp-highlight-content">
                        <h6>StayCover Protection Included</h6>
                        <p>Every booking includes comprehensive protection from host cancellations and listing inaccuracies.</p>
                    </div>
                </div>
            </div>

            <div class="sp-divider"></div>

            <!-- ABOUT THE STAY / DESCRIPTION -->
            <div class="mb-4">
                <h4 class="sp-sec-title">
                    <i class="fa-solid fa-align-left text-danger"></i> About this place
                </h4>
                <div class="sp-description-text"><%= listing.description %></div>
            </div>

            <div class="sp-divider"></div>

            <!-- AMENITIES ("WHAT THIS PLACE OFFERS") -->
            <div class="mb-4">
                <h4 class="sp-sec-title">
                    <i class="fa-solid fa-sparkles text-danger"></i> What this place offers
                </h4>

                <% 
                    const amenityIconMap = {
                        "WiFi": "fa-wifi",
                        "Air conditioning": "fa-snowflake",
                        "Kitchen": "fa-kitchen-set",
                        "Free parking": "fa-square-parking",
                        "TV": "fa-tv",
                        "Swimming pool": "fa-person-swimming",
                        "Mountain view": "fa-mountain",
                        "Pet friendly": "fa-paw",
                        "Dedicated workspace": "fa-laptop",
                        "BBQ grill": "fa-fire-burner",
                        "Private bathroom": "fa-bath",
                        "Hot water": "fa-shower"
                    };
                %>

                <div class="sp-amenities-grid">
                    <% if (listing.amenities && listing.amenities.length > 0) { %>
                        <% listing.amenities.forEach(function(item) { %>
                            <% const iconClass = amenityIconMap[item] || "fa-circle-check"; %>
                            <div class="sp-amenity-card">
                                <i class="fa-solid <%= iconClass %>"></i>
                                <span><%= item %></span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="sp-amenity-card"><i class="fa-solid fa-wifi"></i> WiFi included</div>
                        <div class="sp-amenity-card"><i class="fa-solid fa-snowflake"></i> Air conditioning</div>
                        <div class="sp-amenity-card"><i class="fa-solid fa-square-parking"></i> Free parking on premises</div>
                        <div class="sp-amenity-card"><i class="fa-solid fa-shower"></i> Hot water & essentials</div>
                    <% } %>
                </div>
            </div>

            <!-- ADMIN CONTROLS (IF LOGGED IN AS ADMIN) -->
            <% if (isAdmin) { %>
            <div class="sp-divider"></div>
            <div class="sp-admin-banner">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-danger fs-5"></i>
                        <div>
                            <b class="text-danger d-block">Admin Property Controls</b>
                            <small class="text-muted">You are viewing this stay with Super Admin privileges</small>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                        </a>
                        <a href="/listings/<%= listing._id %>/reservations" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
                            <i class="fa-solid fa-calendar-check me-1"></i> Reservations
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline"
                              data-confirm="Are you sure you want to permanently delete this property as Super Admin? All associated photos and reviews will be removed."
                              data-confirm-title="Admin: Delete Listing?"
                              data-confirm-btn="Delete Permanently"
                              data-confirm-cancel="Nevermind"
                              data-confirm-type="danger"
                              data-confirm-icon="fa-trash-can">
                            <button class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>

            <div class="sp-divider"></div>

            <!-- REVIEWS SECTION -->
            <div id="reviewsSection" class="mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h4 class="sp-sec-title mb-0">
                        <i class="fa-solid fa-star text-warning"></i>
                        <%= avgRating ? avgRating : "No ratings yet" %>
                        <% if (listing.reviews.length > 0) { %>
                            &bull; <%= listing.reviews.length %> Review<%= listing.reviews.length > 1 ? 's' : '' %>
                        <% } %>
                    </h4>
                </div>

                <!-- ADD REVIEW FORM (VERIFIED GUESTS ONLY) -->
                <% if (currUser) { %>
                    <% if (typeof isUserVerifiedGuest !== "undefined" && isUserVerifiedGuest) { %>
                        <div class="p-3 mb-4 rounded-4 border bg-body-tertiary shadow-sm">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="fa-solid fa-circle-check"></i> Verified Guest &bull; You stayed at this property
                                </span>
                            </div>

                            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation" id="reviewForm">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-muted">Your Rating Score</label>
                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>

                                <!-- QUICK COMPLIMENT TAGS -->
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-medium mb-1">Quick highlights (tap to add):</label>
                                    <div class="d-flex flex-wrap gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.78rem;" onclick="addReviewTag('Super clean property! ')">+ Clean Space</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.78rem;" onclick="addReviewTag('Great, welcoming host! ')">+ Friendly Host</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.78rem;" onclick="addReviewTag('Accurate photos and description. ')">+ Accurate Photos</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.78rem;" onclick="addReviewTag('Fast WiFi and great amenities. ')">+ Fast WiFi</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.78rem;" onclick="addReviewTag('Peaceful and scenic surroundings. ')">+ Peaceful</button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between">
                                        <label for="comment" class="form-label fw-semibold small">Your Experience</label>
                                        <span class="text-muted small" id="reviewCharCount">0 / 500</span>
                                    </div>
                                    <textarea
                                        name="review[comment]"
                                        id="comment"
                                        rows="3"
                                        placeholder="Tell other travelers what you enjoyed about the stay, location, and hospitality..."
                                        class="form-control"
                                        maxlength="500"
                                        required
                                    ></textarea>
                                    <div class="invalid-feedback small">Please write a brief comment about your experience.</div>
                                </div>

                                <button class="btn btn-brand rounded-pill px-4 py-2 fw-semibold" id="reviewSubmitBtn">
                                    <i class="fa-solid fa-paper-plane me-1"></i> Submit Verified Review
                                </button>
                            </form>
                        </div>
                    <% } else { %>
                        <div class="alert alert-light border small text-muted my-3 p-3 rounded-3 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-success fs-5"></i>
                            <div>
                                <b>Verified Reviews Only:</b> Only guests who have completed a confirmed reservation for this property can write a review.
                            </div>
                        </div>
                    <% } %>
                <% } %>

                <!-- ALL REVIEWS LIST -->
                <% if (listing.reviews.length > 0) { %>
                    <div class="row g-3">
                        <% for (review of listing.reviews) { %>
                        <div class="col-12 col-md-6">
                            <div class="sp-review-card">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sp-reviewer-avatar">
                                            <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@<%= review.author ? review.author.username : 'Guest' %></h6>
                                            <small class="text-muted">Verified Stay</small>
                                        </div>
                                    </div>
                                    <% if (review.isVerifiedGuest) { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem;">
                                            <i class="fa-solid fa-circle-check"></i> Stayed
                                        </span>
                                    <% } %>
                                </div>

                                <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                                <p class="mb-3 text-muted small" style="line-height: 1.5;"><%= review.comment %></p>

                                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                      data-confirm="Are you sure you want to delete your review? This action cannot be undone."
                                      data-confirm-title="Delete Review?"
                                      data-confirm-btn="Delete Review"
                                      data-confirm-cancel="Keep Review"
                                      data-confirm-type="danger"
                                      data-confirm-icon="fa-trash-can">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" style="font-size: 0.78rem;">
                                        <i class="fa-solid fa-trash me-1"></i> Delete
                                    </button>
                                </form>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-4 p-3 rounded-4 bg-light-subtle border">
                        <i class="fa-regular fa-comment-dots fs-2 text-muted mb-2"></i>
                        <h6 class="fw-bold">No reviews yet</h6>
                        <p class="text-muted small mb-0">Be among the first guests to stay here and leave a review!</p>
                    </div>
                <% } %>
            </div>

            <div class="sp-divider"></div>

            <!-- 5. NEIGHBORHOOD & MAP SECTION -->
            <div id="mapSection" class="mb-5">
                <h4 class="sp-sec-title">
                    <i class="fa-solid fa-map-location-dot text-danger"></i> Where you'll be
                </h4>
                <p class="text-muted small mb-3">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                    <%= listing.location %>, <%= listing.country %> &bull; Exact landmark coordinates provided upon booking
                </p>
                <div id="map" class="sp-map-box"></div>
            </div>

        </div>

        <!-- RIGHT COLUMN: STICKY BOOKING WIDGET OR HOST CONTROL CARD -->
        <div class="col-12 col-lg-4">
            <% 
                const isPlatformAdmin = Boolean(
                    currUser && (currUser.email === (process.env.ADMIN_EMAIL || "shubhamkumar979883@gmail.com"))
                );
                const isHostUser = Boolean(currUser && listing.owner && listing.owner._id.equals(currUser._id));
            %>

            <% if (isHostUser && !isPlatformAdmin) { %>
            <div id="hostManagementWidget" class="sp-widget p-4">
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <div class="rounded-circle p-2 bg-danger-subtle text-danger d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px; font-size: 1.3rem;">
                        <i class="fa-solid fa-crown"></i>
                    </div>
                    <div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold px-2 py-1 mb-1">Host Portal</span>
                        <h5 class="fw-bold mb-0">Your Property</h5>
                    </div>
                </div>

                <div class="p-3 rounded-3 bg-light-subtle border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Base Tariff:</span>
                        <span class="fw-bold fs-6">&#8377;<%= listing.price.toLocaleString("en-IN") %> <small class="text-muted fw-normal">/ night</small></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Govt. GST Slab:</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">+<%= listing.price <= 7500 ? '12%' : '18%' %> GST</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Max Guests:</span>
                        <span class="fw-semibold small"><i class="fa-solid fa-users me-1 text-danger"></i><%= listing.maxGuests || 4 %> Guests</span>
                    </div>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <a href="/listings/<%= listing._id %>/reservations" class="btn btn-brand rounded-pill py-2 fw-bold text-center shadow-sm">
                        <i class="fa-solid fa-calendar-check me-2"></i> View Guest Reservations
                    </a>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold text-center">
                        <i class="fa-solid fa-pen-to-square me-2"></i> Edit Property Details
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
                          data-confirm="Are you sure you want to delete this listing? (Active future reservations will block deletion)"
                          data-confirm-title="Delete Listing?"
                          data-confirm-btn="Yes, Delete Listing"
                          data-confirm-cancel="Nevermind"
                          data-confirm-type="danger"
                          data-confirm-icon="fa-trash-can">
                        <button type="submit" class="btn btn-outline-danger rounded-pill py-2 fw-semibold w-100">
                            <i class="fa-solid fa-trash-can me-2"></i> Delete Listing
                        </button>
                    </form>
                </div>

                <div class="text-center pt-2 border-top">
                    <p class="text-muted small mb-0" style="font-size: 0.78rem;">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i> As the property host, you cannot book your own listing. Use this portal to manage reservations and property details.
                    </p>
                </div>
            </div>
            <% } else if (currUser) { %>

            <% if (isPlatformAdmin) { %>
            <!-- ADMIN HOST QUICK ACTIONS -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden" style="background: linear-gradient(135deg, rgba(254, 66, 77, 0.08) 0%, rgba(254, 66, 77, 0.02) 100%); border: 1.5px solid rgba(254, 66, 77, 0.25) !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom border-danger-subtle">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger text-white rounded-pill px-2 py-1 shadow-sm">
                                <i class="fa-solid fa-crown text-warning me-1"></i> Admin & Host
                            </span>
                            <span class="small fw-bold text-dark">Shubham Kumar</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">
                            <i class="fa-solid fa-shield-check"></i> Superhost
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/listings/<%= listing._id %>/reservations" class="btn btn-sm btn-white bg-white border border-secondary-subtle rounded-pill flex-fill fw-bold text-dark shadow-sm">
                            <i class="fa-solid fa-calendar-check text-danger me-1"></i> Reservations
                        </a>
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-white bg-white border border-secondary-subtle rounded-pill flex-fill fw-bold text-dark shadow-sm">
                            <i class="fa-solid fa-pen-to-square text-primary me-1"></i> Edit
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline"
                              data-confirm="Delete this listing?"
                              data-confirm-title="Delete Listing?"
                              data-confirm-btn="Delete"
                              data-confirm-cancel="Cancel"
                              data-confirm-type="danger"
                              data-confirm-icon="fa-trash-can">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 31px; height: 31px;" title="Delete Listing">
                                <i class="fa-solid fa-trash-can" style="font-size: 0.75rem;"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>
            <div id="booking" class="sp-widget">
                <div class="sp-widget-header">
                    <div>
                        <span class="sp-widget-price">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
                        <span class="sp-widget-price-sub">/ night</span>
                        <div>
                            <span class="sp-widget-gst-pill">
                                <i class="fa-solid fa-receipt me-1"></i>+<%= listing.price <= 7500 ? '12%' : '18%' %> GST (Govt. tariff slab)
                            </span>
                        </div>
                    </div>
                    <div class="text-end small text-muted">
                        <div class="fw-bold text-dark">
                            <i class="fa-solid fa-star text-warning"></i>
                            <span><%= avgRating || "New" %></span>
                        </div>
                        <span style="font-size: 0.75rem;"><%= listing.reviews.length %> reviews</span>
                    </div>
                </div>

                <p id="bookingError" class="text-danger d-none small mb-2 p-2 bg-danger-subtle rounded-2 border border-danger-subtle"></p>

                <form novalidate class="needs-validation" id="bookingForm">
                    <!-- DUAL DATE BOX -->
                    <div class="sp-dates-box row g-0">
                        <div class="col-6 sp-date-col">
                            <label for="checkIn" class="sp-date-label">Check-in</label>
                            <input type="date" name="booking[checkIn]" id="checkIn" class="sp-date-input" required />
                        </div>
                        <div class="col-6 sp-date-col">
                            <label for="checkOut" class="sp-date-label">Check-out</label>
                            <input type="date" name="booking[checkOut]" id="checkOut" class="sp-date-input" required />
                        </div>
                    </div>

                    <!-- GUEST STEPPER -->
                    <div class="sp-guests-box">
                        <div>
                            <label class="sp-date-label mb-0">Guests</label>
                            <span class="fw-bold small d-block" id="guestCountDisplay">1 Guest</span>
                            <span class="text-muted" style="font-size: 0.72rem;">Max <%= listing.maxGuests || 4 %> guests</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="sp-stepper-btn" id="guestMinusBtn">-</button>
                            <input type="hidden" name="booking[guests]" id="guests" value="1" min="1" max="<%= listing.maxGuests || 4 %>" />
                            <button type="button" class="sp-stepper-btn" id="guestPlusBtn">+</button>
                        </div>
                    </div>

                    <!-- REALISTIC PRICE BREAKDOWN CALCULATOR -->
                    <div id="priceBreakdown" class="d-none sp-breakdown-card">
                        <div class="sp-price-line">
                            <span id="nightsLabel">₹0 x 0 nights</span>
                            <strong id="subtotalAmt">₹0</strong>
                        </div>
                        <div class="sp-price-line">
                            <span class="d-flex align-items-center gap-1">
                                StayHub Service Fee (5%)
                                <i class="fa-solid fa-circle-info text-secondary" style="font-size: 0.72rem;" title="Covers 24/7 guest support, booking protection & secure payment gateway"></i>
                            </span>
                            <strong id="feeAmt">₹0</strong>
                        </div>

                        <!-- REAL INDIAN GST ACCORDION -->
                        <div class="sp-gst-box">
                            <div class="sp-gst-header">
                                <span class="d-flex align-items-center gap-1">
                                    <i class="fa-solid fa-receipt text-danger"></i>
                                    <span id="gstRateTitle">Taxes & GST</span>
                                </span>
                                <span id="gstTotalAmt">₹0</span>
                            </div>
                            <div class="sp-gst-subline">
                                <span id="cgstLabel">Central GST (CGST):</span>
                                <span id="cgstAmt">₹0</span>
                            </div>
                            <div class="sp-gst-subline">
                                <span id="sgstLabel">State GST (SGST):</span>
                                <span id="sgstAmt">₹0</span>
                            </div>
                            <div class="pt-1 mt-1 border-top text-muted" style="font-size: 0.68rem;" id="gstSlabNotice">
                                <i class="fa-solid fa-circle-check text-success me-1"></i> Govt. Norm: Standard Indian Hotel GST
                            </div>
                        </div>

                        <div class="sp-total-line">
                            <div>
                                <span class="d-block">Total Payable</span>
                                <small class="text-muted fw-normal" style="font-size: 0.7rem;">(All taxes & fees included)</small>
                            </div>
                            <span id="totalAmt" class="text-danger">₹0</span>
                        </div>
                    </div>

                    <!-- TRUST ASSURANCE -->
                    <div class="d-flex align-items-center gap-2 text-success small mb-3">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Free cancellation &bull; Official GST Invoice generated</span>
                    </div>

                    <!-- BOOK BUTTON -->
                    <button class="btn btn-brand w-100 py-3 fw-bold rounded-pill shadow-sm" id="bookBtn" type="submit" style="font-size: 1.05rem;">
                        <i class="fa-solid fa-lock me-1"></i> Pay & Confirm Reservation
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted d-block" style="font-size: 0.74rem;">
                            <i class="fa-solid fa-bolt text-warning me-1"></i> Instant Confirmation via Razorpay
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">
                            You won't be charged extra fees upon check-in
                        </small>
                    </div>
                </form>
            </div>
            <% } else { %>
            <div id="booking" class="sp-widget text-center py-4">
                <i class="fa-solid fa-lock fs-1 text-danger mb-2"></i>
                <h4 class="fw-bold mb-2">Sign in to Book</h4>
                <p class="text-muted small mb-4">Please log in or create an account to view live availability and reserve this stay.</p>
                <a href="/login?redirect=/listings/<%= listing._id %>" class="btn btn-brand w-100 py-2 rounded-pill fw-bold">
                    Log In to Reserve
                </a>
            </div>
            <% } %>
        </div>

    </div>

</div>

<!-- JAVASCRIPT LOGIC -->
<script>
    // 1. Share Listing Handler
    async function handleShareListing() {
        const shareData = {
            title: listing.title,
            text: `Check out ${listing.title} on StayHub!`,
            url: window.location.href,
        };

        if (navigator.share) {
            try {
                await navigator.share(shareData);
            } catch (err) {
                // user cancelled
            }
        } else {
            try {
                await navigator.clipboard.writeText(window.location.href);
                if (typeof showToast === "function") {
                    showToast("Listing link copied to clipboard! 📋", "success");
                }
            } catch (e) {
                if (typeof showToast === "function") {
                    showToast("Could not copy link to clipboard.", "danger");
                }
            }
        }
    }

    // 2. Review Tag Appender
    function addReviewTag(text) {
        const comment = document.getElementById("comment");
        if (comment) {
            comment.value = (comment.value ? comment.value.trim() + " " : "") + text;
            const count = document.getElementById("reviewCharCount");
            if (count) count.textContent = `${comment.value.length} / 500`;
        }
    }

    const reviewComment = document.getElementById("comment");
    if (reviewComment) {
        reviewComment.addEventListener("input", function() {
            const count = document.getElementById("reviewCharCount");
            if (count) count.textContent = `${this.value.length} / 500`;
        });
    }

    // 3. Guest Stepper Logic
    const guestsInput = document.getElementById("guests");
    const guestMinusBtn = document.getElementById("guestMinusBtn");
    const guestPlusBtn = document.getElementById("guestPlusBtn");
    const guestDisplay = document.getElementById("guestCountDisplay");
    const maxListingGuests = <%= listing.maxGuests || 4 %>;

    if (guestsInput && guestMinusBtn && guestPlusBtn && guestDisplay) {
        function updateGuestUI(val) {
            guestsInput.value = val;
            guestDisplay.textContent = `${val} Guest${val > 1 ? "s" : ""}`;
            guestMinusBtn.disabled = (val <= 1);
            guestPlusBtn.disabled = (val >= maxListingGuests);
        }

        guestMinusBtn.addEventListener("click", () => {
            let val = parseInt(guestsInput.value) || 1;
            if (val > 1) updateGuestUI(val - 1);
        });

        guestPlusBtn.addEventListener("click", () => {
            let val = parseInt(guestsInput.value) || 1;
            if (val < maxListingGuests) updateGuestUI(val + 1);
        });

        updateGuestUI(parseInt(guestsInput.value) || 1);
    }

    // 4. Booking Date & Real-time GST Breakdown Logic
    (function () {
        const pricePerNight = <%- listing.price %>;
        const serviceFeePercent = 0.05; // 5% StayHub platform fee
        const gstRatePercent = pricePerNight <= 7500 ? 0.12 : 0.18; // Real Indian Hotel GST tariff slab
        const gstRateDisplay = pricePerNight <= 7500 ? 12 : 18;
        const halfGstDisplay = gstRateDisplay / 2;

        const checkInInput = document.getElementById("checkIn");
        const checkOutInput = document.getElementById("checkOut");
        const errorBox = document.getElementById("bookingError");
        const breakdown = document.getElementById("priceBreakdown");
        const form = document.getElementById("bookingForm");

        if (!checkInInput) return;

        const todayStr = new Date().toISOString().split("T")[0];
        checkInInput.setAttribute("min", todayStr);

        function datesOverlap(inA, outA, inB, outB) {
            return inA < outB && inB < outA;
        }

        function showError(msg) {
            errorBox.textContent = msg;
            errorBox.classList.remove("d-none");
            breakdown.classList.add("d-none");
        }

        function clearError() {
            errorBox.classList.add("d-none");
            errorBox.textContent = "";
        }

        function updateBreakdown() {
            clearError();
            if (!checkInInput.value || !checkOutInput.value) {
                breakdown.classList.add("d-none");
                return;
            }

            const checkIn = new Date(checkInInput.value);
            const checkOut = new Date(checkOutInput.value);
            checkOutInput.setAttribute("min", checkInInput.value);

            if (checkOut <= checkIn) {
                showError("Check-out date must be after check-in date");
                return;
            }

            const clash = bookedRanges.some((b) =>
                datesOverlap(checkIn, checkOut, new Date(b.checkIn), new Date(b.checkOut))
            );
            if (clash) {
                showError("These dates are already booked. Please choose different dates.");
                return;
            }

            const diffTime = Math.abs(checkOut - checkIn);
            const nights = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));
            const subtotal = nights * pricePerNight;
            const fee = Math.round(subtotal * serviceFeePercent);
            
            const taxableAmount = subtotal + fee;
            const gstAmount = Math.round(taxableAmount * gstRatePercent);
            const cgst = Math.round(gstAmount / 2);
            const sgst = gstAmount - cgst;
            const total = subtotal + fee + gstAmount;

            document.getElementById("nightsLabel").textContent =
                `₹${pricePerNight.toLocaleString("en-IN")} x ${nights} night${nights > 1 ? "s" : ""}`;
            document.getElementById("subtotalAmt").textContent = `₹${subtotal.toLocaleString("en-IN")}`;
            document.getElementById("feeAmt").textContent = `₹${fee.toLocaleString("en-IN")}`;
            
            document.getElementById("gstRateTitle").textContent = `Taxes & GST (${gstRateDisplay}%)`;
            document.getElementById("gstTotalAmt").textContent = `₹${gstAmount.toLocaleString("en-IN")}`;
            document.getElementById("cgstLabel").textContent = `Central GST (CGST ${halfGstDisplay}%):`;
            document.getElementById("cgstAmt").textContent = `₹${cgst.toLocaleString("en-IN")}`;
            document.getElementById("sgstLabel").textContent = `State GST (SGST ${halfGstDisplay}%):`;
            document.getElementById("sgstAmt").textContent = `₹${sgst.toLocaleString("en-IN")}`;
            
            const slabNotice = document.getElementById("gstSlabNotice");
            if (slabNotice) {
                if (pricePerNight <= 7500) {
                    slabNotice.innerHTML = '<i class="fa-solid fa-circle-check text-success me-1"></i> Govt. Norm: 12% GST (Tariff ≤ ₹7,500/night)';
                } else {
                    slabNotice.innerHTML = '<i class="fa-solid fa-circle-check text-success me-1"></i> Govt. Norm: 18% Luxury GST (Tariff > ₹7,500/night)';
                }
            }

            document.getElementById("totalAmt").textContent = `₹${total.toLocaleString("en-IN")}`;
            breakdown.classList.remove("d-none");
        }

        checkInInput.addEventListener("change", updateBreakdown);
        checkOutInput.addEventListener("change", updateBreakdown);

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            if (!checkInInput.value || !checkOutInput.value) {
                showError("Please select both Check-in and Check-out dates.");
                return;
            }

            const checkIn = new Date(checkInInput.value);
            const checkOut = new Date(checkOutInput.value);

            if (isNaN(checkIn.getTime()) || isNaN(checkOut.getTime())) {
                showError("Please enter valid dates.");
                return;
            }

            if (checkOut <= checkIn) {
                showError("Check-out date must be after check-in date.");
                return;
            }

            const clash = bookedRanges.some((b) =>
                datesOverlap(checkIn, checkOut, new Date(b.checkIn), new Date(b.checkOut))
            );
            if (clash) {
                showError("These dates are already booked. Please choose different dates.");
                return;
            }

            const bookBtn = document.getElementById("bookBtn");
            bookBtn.disabled = true;
            bookBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Connecting to Payment Gateway...';

            try {
                const orderRes = await fetch(`/listings/${listing._id}/create-order`, {
                    method: "POST",
                    headers: { 
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        booking: {
                            checkIn: checkInInput.value,
                            checkOut: checkOutInput.value,
                            guests: Number(document.getElementById("guests").value) || 1,
                        },
                    }),
                });

                if (orderRes.status === 401) {
                    window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }

                const orderData = await orderRes.json();

                if (!orderRes.ok) {
                    if (orderData.requireLogin) {
                        window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
                        return;
                    }
                    showError(orderData.error || "Could not initialize booking. Please try again.");
                    bookBtn.disabled = false;
                    bookBtn.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Pay & Confirm Reservation';
                    return;
                }

                if (typeof Razorpay === "undefined") {
                    showError("Razorpay payment gateway script could not be loaded. Please disable ad-blockers and refresh.");
                    bookBtn.disabled = false;
                    bookBtn.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Pay & Confirm Reservation';
                    return;
                }

                const options = {
                    key: orderData.key,
                    amount: orderData.amount,
                    currency: "INR",
                    name: "StayHub",
                    description: listing.title,
                    order_id: orderData.orderId,
                    prefill: {
                        name: typeof razorpayUserName !== "undefined" ? razorpayUserName : "",
                        email: typeof razorpayUserEmail !== "undefined" ? razorpayUserEmail : "",
                    },
                    theme: { color: "#fe424d" },
                    handler: function (response) {
                        const proofForm = document.createElement("form");
                        proofForm.method = "POST";
                        proofForm.action = `/listings/${listing._id}/verify-payment`;

                        const fields = {
                            razorpay_order_id: response.razorpay_order_id,
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_signature: response.razorpay_signature,
                            checkIn: checkInInput.value,
                            checkOut: checkOutInput.value,
                            guests: document.getElementById("guests").value,
                        };

                        for (const key in fields) {
                            const input = document.createElement("input");
                            input.type = "hidden";
                            input.name = key;
                            input.value = fields[key];
                            proofForm.appendChild(input);
                        }

                        document.body.appendChild(proofForm);
                        proofForm.submit();
                    },
                    modal: {
                        ondismiss: function () {
                            bookBtn.disabled = false;
                            bookBtn.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Pay & Confirm Reservation';
                        },
                    },
                };

                const rzp = new Razorpay(options);
                rzp.open();
            } catch (err) {
                console.error("Booking error:", err);
                showError("Payment gateway initialization failed. Please check your internet connection.");
                bookBtn.disabled = false;
                bookBtn.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Pay & Confirm Reservation';
            }
        });
    })();

    // 5. Wishlist AJAX Toggle Logic
    async function handleShowWishlistToggle(listingId) {
        const btn = document.getElementById("showWishlistBtn");
        const icon = document.getElementById("showWishlistIcon");
        const text = document.getElementById("showWishlistText");

        try {
            const res = await fetch(`/wishlist/${listingId}/toggle`, {
                method: "POST",
                headers: { "Content-Type": "application/json" }
            });
            const data = await res.json();
            if (data.requireLogin) {
                window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}&msg=wishlist`;
                return;
            }
            if (data.success) {
                if (data.favorited) {
                    btn.classList.add("active");
                    icon.classList.remove("fa-regular");
                    icon.classList.add("fa-solid");
                    text.textContent = "Saved";
                } else {
                    btn.classList.remove("active");
                    icon.classList.remove("fa-solid");
                    icon.classList.add("fa-regular");
                    text.textContent = "Save";
                }
                if (typeof updateNavWishlistBadge === "function" && typeof data.count !== "undefined") {
                    updateNavWishlistBadge(data.count);
                }
                if (typeof showToast === "function") {
                    showToast(data.message || (data.favorited ? "Saved to wishlist ❤️" : "Removed from wishlist"));
                }
            }
        } catch (err) {
            console.error("Wishlist error:", err);
        }
    }
</script>

