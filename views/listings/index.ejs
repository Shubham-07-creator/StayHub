<% layout("/layouts/boilerplate") %>

<style>
    :root {
        --ip-brand: #fe424d;
        --ip-brand-dark: #e63946;
        --ip-text: #222222;
        --ip-muted: #6a6a6a;
        --ip-border: #e4e4e4;
        --ip-radius: 1rem;
        --ip-shadow: 0 2px 8px rgba(0,0,0,0.08);
        --ip-shadow-hover: 0 12px 24px rgba(0,0,0,0.14);
    }

    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0;
        border-bottom: 1px solid var(--ip-border);
        padding-bottom: 0.5rem;
    }

    .ip-filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 1.25rem;
        opacity: 0.65;
        text-decoration: none;
        color: var(--ip-text);
        border-bottom: 2px solid transparent;
        padding-bottom: 0.6rem;
        transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .ip-filter:hover,
    .ip-filter.active {
        opacity: 1;
        color: var(--ip-brand);
        border-bottom: 2px solid var(--ip-brand);
        cursor: pointer;
    }

    .ip-filter p {
        font-size: 0.8rem;
        margin-bottom: 0;
        margin-top: 0.3rem;
    }

    .ip-tax-info {
        display: none;
    }

    .ip-tax-toggle {
        border: 1px solid var(--ip-border);
        border-radius: 1rem;
        padding: 0.6rem 1rem;
        margin-left: auto;
        margin-top: 1.25rem;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    .ip-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 1.75rem;
        margin-top: 1.5rem;
    }

    .ip-card {
        text-decoration: none;
        color: inherit;
    }

    .ip-img-wrap {
        position: relative;
        border-radius: var(--ip-radius);
        overflow: hidden;
        box-shadow: var(--ip-shadow);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .ip-card:hover .ip-img-wrap {
        box-shadow: var(--ip-shadow-hover);
        transform: translateY(-3px);
    }

    .ip-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .ip-card:hover .ip-img {
        transform: scale(1.04);
    }

    .ip-img-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(0,0,0,0);
        transition: background-color 0.2s ease;
    }

    .ip-card:hover .ip-img-overlay {
        background-color: rgba(0,0,0,0.06);
    }

    .ip-body {
        padding-top: 0.6rem;
    }

    .ip-title {
        font-weight: 700;
        color: var(--ip-text);
        margin-bottom: 0.15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ip-location {
        color: var(--ip-muted);
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
    }

    .ip-price {
        color: var(--ip-text);
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .ip-book-btn {
        display: block;
        text-align: center;
        width: 100%;
        background-color: var(--ip-brand);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: 0.5rem 0;
        text-decoration: none;
        transition: background-color 0.15s ease, transform 0.1s ease;
    }

    .ip-book-btn:hover {
        background-color: var(--ip-brand-dark);
        color: #fff;
        transform: translateY(-1px);
    }

    .ip-empty {
        text-align: center;
        padding: 4rem 1rem;
        color: var(--ip-muted);
    }

    .ip-empty i {
        font-size: 2.5rem;
        color: var(--ip-brand);
        margin-bottom: 1rem;
        display: block;
    }

    .ip-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin: 2.5rem 0;
    }

    .ip-page-btn {
        border: 1.5px solid var(--ip-brand);
        color: var(--ip-brand);
        background: transparent;
        border-radius: 999px;
        padding: 0.5rem 1.3rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .ip-page-btn:hover {
        background-color: var(--ip-brand);
        color: #fff;
    }

    .ip-page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
    }

    .ip-page-info {
        color: var(--ip-muted);
        font-size: 0.9rem;
    }

    @media (max-width: 575.98px) {
        .ip-grid {
            grid-template-columns: 1fr;
        }
        .ip-tax-toggle {
            margin-left: 0;
            width: 100%;
        }
    }
</style>

<div id="filters">

  <a href="/listings?category=trending" class="ip-filter <%= category === 'trending' ? 'active' : '' %>">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>

  <a href="/listings?category=rooms" class="ip-filter <%= category === 'rooms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>

  <a href="/listings?category=iconic" class="ip-filter <%= category === 'iconic' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>

  <a href="/listings?category=mountains" class="ip-filter <%= category === 'mountains' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>

  <a href="/listings?category=castles" class="ip-filter <%= category === 'castles' ? 'active' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>

  <a href="/listings?category=pools" class="ip-filter <%= category === 'pools' ? 'active' : '' %>">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>

  <a href="/listings?category=camping" class="ip-filter <%= category === 'camping' ? 'active' : '' %>">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>

  <a href="/listings?category=farms" class="ip-filter <%= category === 'farms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-tractor"></i></div>
    <p>Farms</p>
  </a>

  <a href="/listings?category=arctic" class="ip-filter <%= category === 'arctic' ? 'active' : '' %>">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>

  <a href="/listings?category=domes" class="ip-filter <%= category === 'domes' ? 'active' : '' %>">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </a>

  <a href="/listings?category=boats" class="ip-filter <%= category === 'boats' ? 'active' : '' %>">
    <div><i class="fa-solid fa-sailboat"></i></div>
    <p>Boats</p>
  </a>

  <% if (category) { %>
  <a href="/listings" class="ip-filter">
    <div><i class="fa-solid fa-xmark"></i></div>
    <p>Clear</p>
  </a>
  <% } %>

  <div class="ip-tax-toggle">
    <div class="form-check-reverse form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">
        Display total after taxes
      </label>
    </div>
  </div>
</div>

<% if (allListings.length === 0) { %>
  <div class="ip-empty">
    <i class="fa-solid fa-house-circle-xmark"></i>
    <h5>No listings found</h5>
    <p>Try a different search term or category.</p>
    <a href="/listings" class="ip-page-btn">View all listings</a>
  </div>
<% } else { %>

<div class="ip-grid">

<% for (let listing of allListings) { %>

  <div>
    <a href="/listings/<%= listing._id %>" class="ip-card">
      <div class="ip-img-wrap">
        <img
          src="<%= listing.image.url %>"
          class="ip-img"
          alt="listing_image"
        />
        <div class="ip-img-overlay"></div>
      </div>

      <div class="ip-body">
        <h6 class="ip-title"><%= listing.title %></h6>
        <p class="ip-location"><%= listing.location %>, <%= listing.country %></p>
        <p class="ip-price">
          &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
          <i class="ip-tax-info">&nbsp;+18% GST</i>
        </p>
      </div>
    </a>

    <% if (currUser) { %>
      <a href="/listings/<%= listing._id %>#booking" class="ip-book-btn">Book Now</a>
    <% } else { %>
      <a href="/login?redirect=/listings/<%= listing._id %>" class="ip-book-btn">Book Now</a>
    <% } %>
  </div>

<% } %>

</div>

<% if (totalPages > 1) { %>
<div class="ip-pagination">
  <a
    href="/listings?page=<%= currentPage - 1 %><%= category ? '&category=' + category : '' %><%= search ? '&search=' + search : '' %>"
    class="ip-page-btn <%= currentPage <= 1 ? 'disabled' : '' %>"
  >&larr; Previous</a>

  <span class="ip-page-info">Page <%= currentPage %> of <%= totalPages %></span>

  <a
    href="/listings?page=<%= currentPage + 1 %><%= category ? '&category=' + category : '' %><%= search ? '&search=' + search : '' %>"
    class="ip-page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"
  >Next &rarr;</a>
</div>
<% } %>

<% } %>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("ip-tax-info");
        for (info of taxInfo) {
            if (info.style.display != "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
</script>
